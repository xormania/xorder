--- /dev/null
+++ b/src/language_server/backend/symbol_references.rs
@@ -0,0 +1,102 @@
+//! Read-only access to the native semantic dependency graph. Graph edges have
+//! no source spans: this is deliberately separate from navigable LSP references.
+
+use serde::{Deserialize, Serialize};
+use tower_lsp_server::gen_lsp_types::TextDocumentIdentifier;
+use tower_lsp_server::jsonrpc::{Error, Result};
+
+use mago_codex::reference::{ReferenceOrigin, SymbolReferenceKind};
+
+use super::Backend;
+use super::query::{request_failed, require_analysis};
+use crate::language_server::uri::UriFilePath;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct SymbolReferencesParams {
+    text_document: TextDocumentIdentifier,
+    symbol: String,
+    #[serde(default)]
+    member: String,
+}
+
+#[derive(Serialize)]
+pub(crate) struct SymbolReferencesResult {
+    source: GraphSymbol,
+    references: Vec<GraphReference>,
+}
+
+#[derive(Serialize)]
+struct GraphSymbol {
+    symbol: String,
+    member: String,
+}
+
+#[derive(Serialize)]
+struct GraphReference {
+    kind: &'static str,
+    target: GraphSymbol,
+}
+
+impl Backend {
+    pub(crate) async fn symbol_references(&self, params: SymbolReferencesParams) -> Result<SymbolReferencesResult> {
+        if params.symbol.is_empty() || params.symbol.len() > 1024 || params.member.len() > 1024 {
+            return Err(Error::invalid_params("symbol must be nonempty; symbol/member lengths must be at most 1024"));
+        }
+        let path = params
+            .text_document
+            .uri
+            .to_file_path()
+            .ok_or_else(|| Error::invalid_params("textDocument.uri must be a local file URI"))?;
+        self.with_registry_mut(|registry| {
+            let workspace = registry
+                .for_path_mut(path.as_ref())
+                .ok_or_else(|| request_failed("No loaded workspace owns textDocument.uri"))?;
+            if !self.config.analyzer {
+                return Err(request_failed("The analyzer is disabled"));
+            }
+            require_analysis(workspace)?;
+            // Classes/functions and methods use Mago's canonical lowercase keys;
+            // property/constant members retain their case-sensitive spelling.
+            let symbol = params.symbol.to_ascii_lowercase();
+            let lowercase_member = params.member.to_ascii_lowercase();
+            let member = if workspace
+                .core
+                .server
+                .codebase()
+                .get_method(symbol.as_bytes(), lowercase_member.as_bytes())
+                .is_some()
+            {
+                lowercase_member
+            } else {
+                params.member
+            };
+            let mut references = Vec::new();
+            workspace.core.server.symbol_references().for_each_reference(|source, target, kind| {
+                let ReferenceOrigin::Symbol((owner, source_member)) = source else { return };
+                if owner.as_str() == Some(symbol.as_str()) && source_member.as_str() == Some(member.as_str()) {
+                    references.push(GraphReference {
+                        kind: match kind {
+                            SymbolReferenceKind::Body => "body",
+                            SymbolReferenceKind::Signature => "signature",
+                            SymbolReferenceKind::OverriddenMember => "overridden_member",
+                            SymbolReferenceKind::FunctionLikeReturn => "function_like_return",
+                            SymbolReferenceKind::PropertyRead => "property_read",
+                            SymbolReferenceKind::PropertyWrite => "property_write",
+                        },
+                        target: GraphSymbol { symbol: target.0.to_string(), member: target.1.to_string() },
+                    });
+                }
+            });
+            references.sort_unstable_by(|left, right| {
+                (&left.kind, &left.target.symbol, &left.target.member).cmp(&(
+                    &right.kind,
+                    &right.target.symbol,
+                    &right.target.member,
+                ))
+            });
+            Ok(SymbolReferencesResult { source: GraphSymbol { symbol, member }, references })
+        })
+        .unwrap_or_else(|| Err(request_failed("Server is not initialized")))
+    }
+}
