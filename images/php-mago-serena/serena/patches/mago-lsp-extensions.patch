+//! Native external analyzer registration and the semantic graph query contract.
+
+use super::harness::{Harness, client_capabilities};
+use crate::language_server::ServerConfig;
+use serde_json::{Value, json};
+
+const SOURCE: &str =
+    "<?php interface First {} interface Second {} class Service { public function __construct(First $value) {} }\n";
+
+async fn graph(h: &mut Harness) -> Value {
+    h.request(
+        "mago/symbolReferences",
+        json!({
+            "textDocument": { "uri": h.url("a.php") },
+            "symbol": "Service", "member": "__construct",
+        }),
+    )
+    .await
+}
+
+async fn restarted(h: &mut Harness) {
+    loop {
+        let message = h.client.await_notification("window/logMessage").await;
+        if message["params"]["message"].as_str().is_some_and(|s| s.starts_with("mago-server: restarted")) {
+            return;
+        }
+    }
+}
+
+#[tokio::test]
+async fn external_graph_uses_current_unsaved_buffers_without_inventing_locations() {
+    let mut h = Harness::start(&[("a.php", SOURCE)]).await;
+    assert_eq!(h.server_capabilities["experimental"]["symbolReferencesProvider"], true);
+    let initial = graph(&mut h).await;
+    assert!(
+        initial["references"].as_array().unwrap().iter().any(|r| r
+            == &json!({
+                "kind": "signature", "target": { "symbol": "first", "member": "" },
+            })),
+        "{initial}"
+    );
+    h.open("a.php", SOURCE).await;
+    h.change("a.php", &SOURCE.replace("First $value", "Second $value"), 2).await;
+    let changed = graph(&mut h).await;
+    let text = changed.to_string();
+    assert!(text.contains("second"), "{changed}");
+    assert!(!text.contains("first"), "{changed}");
+    assert!(!text.contains("range") && !text.contains("location"), "{changed}");
+    assert_eq!(std::fs::read_to_string(h.workspace.join("a.php")).unwrap(), SOURCE);
+    h.close("a.php").await;
+    assert_eq!(graph(&mut h).await, initial);
+}
+
+#[tokio::test]
+async fn external_disabled_hosts_do_not_start_and_native_graph_still_works() {
+    let mut h = Harness::start(&[
+        ("a.php", SOURCE),
+        (
+            "mago.toml",
+            r#"
+[extension-hosts.unavailable]
+enabled = false
+command = ["/no/such/external-worker"]
+"#,
+        ),
+    ])
+    .await;
+    assert!(!graph(&mut h).await["references"].as_array().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn external_failed_reload_refuses_old_graph_and_recovers_after_disable() {
+    let mut h = Harness::start(&[("a.php", SOURCE), ("mago.toml", "")]).await;
+    let initial = graph(&mut h).await;
+    let broken = "[extension-hosts.unavailable]\ncommand = [\"/no/such/external-worker\"]\nrequest-timeout-ms = 100\n";
+    std::fs::write(h.workspace.join("mago.toml"), broken).unwrap();
+    h.watched("mago.toml", 2).await;
+    loop {
+        let message = h.client.await_notification("window/showMessage").await;
+        if message["params"]["message"].as_str().is_some_and(|s| s.contains("cannot restart")) {
+            break;
+        }
+    }
+    let failed = h
+        .try_request(
+            "mago/symbolReferences",
+            json!({
+                "textDocument": { "uri": h.url("a.php") }, "symbol": "Service", "member": "__construct",
+            }),
+        )
+        .await
+        .unwrap_err();
+    assert!(failed["message"].as_str().unwrap().contains("Workspace reload failed"), "{failed}");
+    std::fs::write(h.workspace.join("mago.toml"), "").unwrap();
+    h.watched("mago.toml", 2).await;
+    restarted(&mut h).await;
+    assert_eq!(graph(&mut h).await, initial);
+}
+
+#[tokio::test]
+async fn external_graph_rejects_disabled_analysis_and_unowned_uri() {
+    let mut h = Harness::start_with(
+        &[("a.php", SOURCE)],
+        ServerConfig { analyzer: false, ..Default::default() },
+        client_capabilities(),
+    )
+    .await;
+    assert!(h.server_capabilities["experimental"].is_null());
+    let error = h
+        .try_request(
+            "mago/symbolReferences",
+            json!({
+                "textDocument": { "uri": h.url("a.php") }, "symbol": "Service", "member": "__construct",
+            }),
+        )
+        .await
+        .unwrap_err();
+    assert!(error["message"].as_str().unwrap().contains("disabled"));
+}
