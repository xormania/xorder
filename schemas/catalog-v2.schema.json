{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version",
          "identity",
          "purpose",
          "capabilities",
          "targets",
          "prerequisites",
          "documentation",
          "release_record",
          "lifecycle",
          "created_at",
          "verification",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(image|binary|environment|configuration|context)/[a-z0-9][a-z0-9./-]*$"
          },
          "kind": {
            "enum": [
              "image",
              "binary",
              "environment",
              "configuration",
              "context"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "prerequisites": {
            "type": "object",
            "required": [
              "commands"
            ],
            "properties": {
              "commands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^(image|binary|environment|configuration|context)/[a-z0-9][a-z0-9./-]*$"
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "documentation": {
            "type": "string",
            "minLength": 1
          },
          "release_record": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": [
              "available",
              "deprecated",
              "withdrawn"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification": {
            "type": "object",
            "required": [
              "status",
              "surface",
              "evidence"
            ],
            "properties": {
              "status": {
                "const": "passed"
              },
              "surface": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "details": {
            "type": "object"
          },
          "delivery": {
            "type": "object",
            "required": [
              "url",
              "sha256",
              "filename",
              "format",
              "size_bytes"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "file",
                  "tar"
                ]
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "assurance": {
            "type": "object",
            "required": [
              "receipt_url",
              "receipt_sha256",
              "predicate_type"
            ],
            "properties": {
              "receipt_url": {
                "type": "string",
                "pattern": "^https://github\\.com/xormania/xorder/releases/download/.+/assurance\\.json$"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "predicate_type": {
                "const": "https://github.com/xormania/xorder/assurance/v1"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
