{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit image recommendation retirement",
  "type": "object",
  "required": ["schema_version", "history_commit", "reason", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "history_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "reason": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sha256", "source_commit"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
