{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "purpose", "dockerfile", "platforms", "abi"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "purpose": {"type": "string", "minLength": 1},
    "dockerfile": {"type": "string", "minLength": 1},
    "target": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
    "platforms": {"const": ["linux/amd64"]},
    "abi": {"type": "string", "minLength": 1},
    "build_args": {"$ref": "#/$defs/arguments"},
    "tool_args": {"$ref": "#/$defs/arguments"},
    "image_bases": {"$ref": "#/$defs/arguments"},
    "components": {"$ref": "#/$defs/arguments"},
    "verify": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "arguments": {
      "type": "object", "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
